# ==============================================================================
# 2cfa-mcp Configuration - Minimal, Fast, and Secure
# ==============================================================================

# Server Listening Port
PORT=2232

# High-entropy secret token for client connection (Required).
# Prefer URL-safe hex/base64url because the default MCP URL mode embeds it in a path.
# Example generator: openssl rand -hex 32
AUTH_TOKEN=replace-with-a-long-random-url-safe-token

# Allowed workspace directory (Relative or Absolute path)
WORKSPACE_PATH=./workspace

# Default command execution timeout in seconds
EXEC_TIMEOUT=120

# Maximum daemon log size before rotating to 2cfa-mcp.log.1 (bytes)
MAX_LOG_BYTES=10485760

# ==============================================================================
# Optional 2FA Security (Can also be toggled directly in chat via setup_2fa)
# ==============================================================================

# 2FA Gate Switch (false by default for zero-friction direct connect)
ENABLE_2FA_GATE=false

# Google Authenticator Base32 Secret Key (Optional, e.g. JBSWY3DPEHPK3PXP)
TOTP_SECRET=
